<mxfile host="app.diagrams.net" type="device" version="24.0.0"><diagram name="04-raw-archive-rollover" id="04-raw-archive-rollover"><mxGraphModel dx="1560" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ilm" value="S3 / AIStor ILM 이 제공하는 것 (객체 단위 1:1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=34;spacingTop=4;fontSize=13;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1480" height="250" as="geometry"/></mxCell><mxCell id="ilm_b" value="ILM" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="26" height="26" as="geometry"/></mxCell><mxCell id="svc" value="서비스(데이터 엔지니어)가 직접 구현해야 하는 Rollover 파이프라인" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=34;spacingTop=4;fontSize=13;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1480" height="420" as="geometry"/></mxCell><mxCell id="svc_b" value="k8s" style="rounded=0;html=1;fillColor=#8C4FFF;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="26" height="26" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="191" y="210" as="sourcePoint"/><mxPoint x="404" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456" y="200" as="sourcePoint"/><mxPoint x="714" y="150" as="targetPoint"/><Array as="points"><mxPoint x="600" y="200"/><mxPoint x="600" y="150"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456" y="220" as="sourcePoint"/><mxPoint x="714" y="270" as="targetPoint"/><Array as="points"><mxPoint x="600" y="220"/><mxPoint x="600" y="270"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="184" as="sourcePoint"/><mxPoint x="958" y="215" as="targetPoint"/><Array as="points"><mxPoint x="430" y="108"/><mxPoint x="900" y="108"/><mxPoint x="900" y="215"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="520" as="sourcePoint"/><mxPoint x="310" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="520" as="sourcePoint"/><mxPoint x="550" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e6" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="520" as="sourcePoint"/><mxPoint x="790" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e7" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="520" as="sourcePoint"/><mxPoint x="1030" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e8" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="520" as="sourcePoint"/><mxPoint x="1270" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e9" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#8C4FFF;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="165" y="300" as="sourcePoint"/><mxPoint x="165" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="raw" value="" style="aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#C72C48;strokeColor=#ffffff;fontColor=#FFFFFF;sketch=0;outlineConnect=0;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="139" y="184" width="52" height="52" as="geometry"/></mxCell><mxCell id="ilmr" value="ILM" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="404" y="184" width="52" height="52" as="geometry"/></mxCell><mxCell id="wt" value="" style="aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#8A1C2E;strokeColor=#ffffff;fontColor=#FFFFFF;sketch=0;outlineConnect=0;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="714" y="124" width="52" height="52" as="geometry"/></mxCell><mxCell id="del" value="DEL" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#7D8998;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="714" y="244" width="52" height="52" as="geometry"/></mxCell><mxCell id="no" value="✕ Lifecycle 에 존재하지 않는 액션&lt;br&gt;· 여러 객체를 하나로 병합 (묶기)&lt;br&gt;· zip / tar.gz / zstd 압축 패키지 생성&lt;br&gt;· 기간·크기 기준 rollover (새 아카이브 객체 생성)&lt;br&gt;· 원본 ↔ 아카이브 정합성 검증 후 원본 삭제&lt;br&gt;※ 서버측 압축(compression)은 투명 압축 — GET 시 원본으로 복원, 아카이브 아님" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#DD344C;fontSize=12;fontColor=#DD344C;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="530" height="190" as="geometry"/></mxCell><mxCell id="s0" value="① 대상 선정&lt;br&gt;ListObjectsV2&lt;br&gt;prefix·날짜 파티션&lt;br&gt;(rollover 기준: 기간·크기)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="s1" value="② 읽기&lt;br&gt;GetObject 병렬 스트리밍" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="310" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="s2" value="③ 패키징·압축&lt;br&gt;zip / tar.zst 생성&lt;br&gt;+ manifest(목록·checksum)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="s3" value="④ 업로드&lt;br&gt;Multipart PutObject&lt;br&gt;→ archive/ 버킷 (Warm)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="790" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="s4" value="⑤ 검증&lt;br&gt;건수·크기·checksum 대조&lt;br&gt;실패 시 재시도·보류" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="s5" value="⑥ 원본 정리&lt;br&gt;DeleteObjects 또는&lt;br&gt;태그 → ILM Expiration" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="note" value="구현 시 필수 고려 사항&lt;br&gt;· 멱등성: 재실행 시 중복 아카이브 방지 (결정적 객체 키: archive/yyyy/mm/dd/part-N.zip)&lt;br&gt;· Versioning ON: 원본 삭제는 delete marker 만 생성 → noncurrent 만료 규칙 별도 필요&lt;br&gt;· Object Lock(WORM) 버킷: 보존 기간 내 원본 삭제 불가 → rollover 대상 버킷 설계 시 제외&lt;br&gt;· Replication: 원본 삭제·아카이브 업로드가 복제 규칙(delete, delete-marker)에 따라 Warm 에 어떻게 반영되는지 확인&lt;br&gt;· 조회: zip 내부 파일은 AIStor S3 Zip 확장(x-minio-extract, 읽기 전용)으로 조회 가능 여부 검토" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#5E6C84;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="1400" height="150" as="geometry"/></mxCell><mxCell id="c11" value="RAW → Archive(zip) — S3 ILM 이 해주는 것 vs 서비스가 구현해야 하는 것" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#000000;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1480" height="30" as="geometry"/></mxCell><mxCell id="c12" value="S3/AIStor Lifecycle 액션은 Transition·Expiration 뿐 — 병합·압축·zip 패키징·rollover 는 애플리케이션 영역" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5E6C84;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1480" height="20" as="geometry"/></mxCell><mxCell id="c13" value="RAW 버킷 (Hot)&lt;br&gt;소형 객체 다수" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="240" width="150" height="36" as="geometry"/></mxCell><mxCell id="c14" value="ILM 규칙&lt;br&gt;(Scanner 가 비동기 평가)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="345" y="240" width="170" height="36" as="geometry"/></mxCell><mxCell id="c15" value="Warm Tier&lt;br&gt;(동일 객체 그대로 이동)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="655" y="180" width="170" height="36" as="geometry"/></mxCell><mxCell id="c16" value="삭제&lt;br&gt;(delete marker)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="665" y="300" width="150" height="36" as="geometry"/></mxCell><mxCell id="c17" value="prefix · tag · 경과일" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="240" y="180" width="120" height="19" as="geometry"/></mxCell><mxCell id="c18" value="Transition" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="80" height="19" as="geometry"/></mxCell><mxCell id="c19" value="Expiration" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="80" height="19" as="geometry"/></mxCell><mxCell id="c20" value="Archive(zip)?" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#DD344C;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="615" y="98" width="90" height="19" as="geometry"/></mxCell><mxCell id="c21" value="실행 주체: k8s CronJob · Airflow DAG · Spark Job (dataops)  /  상태 저장: 체크포인트 테이블 또는 manifest 객체" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5E6C84;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="1000" height="22" as="geometry"/></mxCell><mxCell id="c22" value="서비스가 직접 읽음" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8C4FFF;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="105" y="350" width="120" height="19" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
