 y="16" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c12" value="Hot 에서는 한 번에 커밋된 스냅샷이 Warm 에는 객체별로 따로·늦게 도착 → Warm 에서 일관된 테이블 보장 안 됨" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5E6C84;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1320" height="20" as="geometry"/></mxCell><mxCell id="c13" value="Snapshot v3 — 한 번에 커밋" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#8C4FFF;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="300" height="20" as="geometry"/></mxCell><mxCell id="c14" value="PENDING … (지연 / 실패)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#DD344C;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="590" y="180" width="180" height="19" as="geometry"/></mxCell><mxCell id="c15" value="t + 2s  ✓" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#ED7100;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="635" y="256" width="90" height="19" as="geometry"/></mxCell><mxCell id="c16" value="t + 1s  ✓ (먼저 도착)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#ED7100;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="605" y="330" width="150" height="19" as="geometry"/></mxCell><mxCell id="c17" value="✕ 복제 대상 아님 (Oracle 의 행)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#DD344C;fontStyle=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="570" y="454" width="220" height="19" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
