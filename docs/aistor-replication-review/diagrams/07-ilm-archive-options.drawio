<mxfile host="app.diagrams.net" type="device" version="24.0.0"><diagram name="07-ilm-archive-options" id="07-ilm-archive-options"><mxGraphModel dx="1500" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g40" value="A. zip 미사용 — RAW 그대로 ILM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=34;spacingTop=4;fontSize=13;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="460" height="540" as="geometry"/></mxCell><mxCell id="g40_b" value="" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="26" height="26" as="geometry"/></mxCell><mxCell id="g520" value="B. 하이브리드 — 서비스 zip + ILM 이관" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=34;spacingTop=4;fontSize=13;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="460" height="540" as="geometry"/></mxCell><mxCell id="g520_b" value="" style="rounded=0;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="26" height="26" as="geometry"/></mxCell><mxCell id="g1000" value="C. 전면 Rollover (기존안)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=34;spacingTop=4;fontSize=13;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="460" height="540" as="geometry"/></mxCell><mxCell id="g1000_b" value="" style="rounded=0;html=1;fillColor=#7D8998;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="26" height="26" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#7AA116;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="225" as="sourcePoint"/><mxPoint x="270" y="255" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#7AA116;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="330" as="sourcePoint"/><mxPoint x="270" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#ED7100;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="225" as="sourcePoint"/><mxPoint x="750" y="255" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#ED7100;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="330" as="sourcePoint"/><mxPoint x="750" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#7D8998;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="225" as="sourcePoint"/><mxPoint x="1230" y="255" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#7D8998;strokeWidth=1.5;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="330" as="sourcePoint"/><mxPoint x="1230" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f400" value="RAW 객체 (Hot)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="380" height="75" as="geometry"/></mxCell><mxCell id="f401" value="ILM Transition&lt;br&gt;(prefix · 경과일)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="255" width="380" height="75" as="geometry"/></mxCell><mxCell id="f402" value="Warm Tier&lt;br&gt;(객체 1:1 · Hot 엔드포인트로 조회)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="380" height="75" as="geometry"/></mxCell><mxCell id="n40" value="장점: 구현 없음 · 조회 경로 그대로&lt;br&gt;고려: 소형 객체 수 유지 → Warm 객체 수·&lt;br&gt;Scanner 부하 · 압축 이득 없음&lt;br&gt;(서버측 투명 압축으로 일부 보완)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#5E6C84;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="420" height="140" as="geometry"/></mxCell><mxCell id="f5200" value="① 서비스: 정책 시점에 zip 변환&lt;br&gt;(예: 파티션 마감 N일 후)&lt;br&gt;→ archive/ prefix 에 저장" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="380" height="75" as="geometry"/></mxCell><mxCell id="f5201" value="② ILM Transition 규칙&lt;br&gt;(archive/ prefix 또는 tag)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="255" width="380" height="75" as="geometry"/></mxCell><mxCell id="f5202" value="Warm Tier&lt;br&gt;(zip 객체 이관)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="380" height="75" as="geometry"/></mxCell><mxCell id="n520" value="장점: 객체 수 감소 · 이관·재시도는 ILM 담당&lt;br&gt;→ 서비스 구현 범위 축소&lt;br&gt;고려: zip 변환·검증·원본 정리는 서비스 ·&lt;br&gt;조회 시 zip 해제 필요 (S3 Zip 확장 🔍)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#5E6C84;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="420" height="140" as="geometry"/></mxCell><mxCell id="f10000" value="서비스: 대상 선정 · 읽기" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="380" height="75" as="geometry"/></mxCell><mxCell id="f10001" value="서비스: zip 생성 · 업로드&lt;br&gt;(Warm archive/ 직접)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="255" width="380" height="75" as="geometry"/></mxCell><mxCell id="f10002" value="서비스: 검증 · 원본 정리" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="380" height="75" as="geometry"/></mxCell><mxCell id="n1000" value="장점: 시점·형식 완전 제어&lt;br&gt;고려: 구현·운영 부담 최대 ·&lt;br&gt;Warm 직접 쓰기 시 복제 방향과 충돌 가능" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#5E6C84;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="480" width="420" height="140" as="geometry"/></mxCell><mxCell id="dec" value="협의 필요 — 결정 기준: ① 아카이브 데이터 조회 요구(빈도 · 방식)  ② 소형 객체 수 · Scanner 부하  ③ 압축 이득(용량)  ④ 서비스 구현 · 운영 부담  ⑤ 보존 · 삭제 정책&lt;br&gt;권고 순서: A 로 시작 가능한지 확인 → 객체 수·용량 문제가 확인되면 B(하이브리드) → C 는 B 로 해결되지 않는 요구가 있을 때만" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#DD344C;fontSize=13;fontColor=#DD344C;fontStyle=1;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="1420" height="105" as="geometry"/></mxCell><mxCell id="c11" value="RAW 아카이브 방식 선택지 — A. zip 미사용 · B. 하이브리드 · C. 전면 Rollover (협의 필요)" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#000000;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1420" height="30" as="geometry"/></mxCell><mxCell id="c12" value="ILM 은 Transition · Expiration 만 제공 (zip 생성 불가) · 하이브리드는 '변환은 서비스, 이관은 ILM' 으로 역할 분리" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5E6C84;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1420" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
