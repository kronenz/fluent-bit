     "Text": {
      "tid": null,
      "valign": "middle",
      "overflow": "none",
      "vposition": "none",
      "hposition": "none",
      "html": "<p style=\"text-align:left;\"><span style=\"font-size:22px;line-height:25px;color:#000000;font-weight:bold;\">운영 모델 — Bucket Replication (AIStor 상시) vs Batch Replication (AIStor 실행 + 외부 오케스트레이션)</span></p>",
      "paddingLeft": 4,
      "paddingRight": 4,
      "paddingBottom": 3,
