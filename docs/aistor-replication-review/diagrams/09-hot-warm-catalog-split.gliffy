      "overflow": "none",
      "vposition": "none",
      "hposition": "none",
      "html": "<p style=\"text-align:left;\"><span style=\"font-size:22px;line-height:25px;color:#000000;font-weight:bold;\">Hot/Warm 카탈로그 분리 — HMS-Hot(이천) · HMS-Warm(용인용) · Polaris federation</span></p>",
      "paddingLeft": 4,
      "paddingRight": 4,
      "paddingBottom": 3,
      "paddingTop": 3
     }
    },
