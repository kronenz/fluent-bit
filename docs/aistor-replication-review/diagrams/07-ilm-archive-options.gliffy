      "overflow": "none",
      "vposition": "none",
      "hposition": "none",
      "html": "<p style=\"text-align:left;\"><span style=\"font-size:22px;line-height:25px;color:#000000;font-weight:bold;\">RAW 아카이브 방식 선택지 — A. zip 미사용 · B. 하이브리드 · C. 전면 Rollover (협의 필요)</span></p>",
      "paddingLeft": 4,
      "paddingRight": 4,
      "paddingBottom": 3,
      "paddingTop": 3
     }
