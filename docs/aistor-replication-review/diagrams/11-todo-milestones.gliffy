      "overflow": "none",
      "vposition": "none",
      "hposition": "none",
      "html": "<p style=\"text-align:left;\"><span style=\"font-size:22px;line-height:25px;color:#000000;font-weight:bold;\">해야 할 일 — 마일스톤 의존 관계 (Replication 우선 → ILM → 향후 구성)</span></p>",
      "paddingLeft": 4,
      "paddingRight": 4,
      "paddingBottom": 3,
      "paddingTop": 3
