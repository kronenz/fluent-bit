ght="40" as="geometry"/></mxCell><mxCell id="no" value="✕ 여러 객체 병합 · 압축 · zip 패키징 · rollover 액션 없음" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#DD344C;fontSize=12;fontColor=#DD344C;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="500" height="56" as="geometry"/></mxCell><mxCell id="r00" value="raw" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="60" height="36" as="geometry"/></mxCell><mxCell id="r01" value="raw" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="170" width="60" height="36" as="geometry"/></mxCell><mxCell id="r10" value="raw" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="60" height="36" as="geometry"/></mxCell><mxCell id="r11" value="raw" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="230" width="60" height="36" as="geometry"/></mxCell><mxCell id="r20" value="raw" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="60" height="36" as="geometry"/></mxCell><mxCell id="r21" value="raw" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="290" width="60" height="36" as="geometry"/></mxCell><mxCell id="job" value="Rollover Job&lt;br&gt;(CronJob / Airflow)&lt;br&gt;① 선정 ② 읽기&lt;br&gt;③ 압축 ④ 업로드 ⑤ 검증" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=12;fontColor=#232F3E;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="zip" value="archive/yyyy/mm/dd/&lt;br&gt;part-N.zip  (Warm)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEFF1;strokeColor=#8A1C2E;fontSize=12;fontColor=#232F3E;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1120" y="215" width="210" height="70" as="geometry"/></mxCell><mxCell id="clean" value="⑥ 원본 정리 — DeleteObjects 또는 태그 → ILM Expiration&lt;br&gt;(Versioning ON 이면 noncurrent 만료 규칙 병행)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#5E6C84;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="390" width="450" height="70" as="geometry"/></mxCell><mxCell id="msg" value="투명 압축(compression)은 GET 시 원본으로 풀림 → 아카이브 아님   |   S3 Zip 확장은 zip 내부 '읽기'만 지원 → zip 생성은 클라이언트 책임" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#232F3E;fontSize=13;fontColor=#232F3E;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1320" height="60" as="geometry"/></mxCell><mxCell id="c11" value="결론 4 — ILM 은 '객체를 옮기거나 지우기'만, zip 아카이브는 서비스가 만든다" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#000000;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c12" value="S3/AIStor Lifecycle 액션 = Transition · Expiration · 병합·압축·zip·rollover 는 없음" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5E6C84;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeo