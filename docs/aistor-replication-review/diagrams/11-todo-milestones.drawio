344C;strokeWidth=1.5;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="150" as="sourcePoint"/><mxPoint x="160" y="218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="150" as="sourcePoint"/><mxPoint x="440" y="218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e12" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;dashPattern=6 4;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="510" as="sourcePoint"/><mxPoint x="598" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m0" value="M0 담당자 우려 · 요구 확인&lt;br&gt;No 1 ~ 3&lt;br&gt;복제 목적 · Warm 조회 케이스&lt;br&gt;RPO/RTO" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="240" height="120" as="geometry"/></mxCell><mxCell id="m1" value="M1 Replication 근거 · 설계&lt;br&gt;No 4 ~ 10&lt;br&gt;보안 PDF · 방향 · 버킷명&lt;br&gt;삭제 플래그 · Scanner" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="220" width="240" height="120" as="geometry"/></mxCell><mxCell id="m2" value="M2 Replication 테스트&lt;br&gt;No 11 ~ 15&lt;br&gt;백업 시점(T-B) · 충돌 C1~C5&lt;br&gt;복제 지연·백로그" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="240" height="120" as="geometry"/></mxCell><mxCell id="m3" value="M3 ILM / Archive 협의 · PoC&lt;br&gt;No 16 ~ 20&lt;br&gt;A 미사용 · B 하이브리드 · C 전면&lt;br&gt;Transition 규칙" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="240" height="120" as="geometry"/></mxCell><mxCell id="m4" value="M4 네트워크 개통&lt;br&gt;No 21 ~ 25&lt;br&gt;(모드 ① 또는 용인 접근 필요 시)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="240" height="120" as="geometry"/></mxCell><mxCell id="m5" value="M5 HMS-Warm · 등록 자동화&lt;br&gt;No 26 ~ 31&lt;br&gt;(모드 ① 일 때만)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="240" height="120" as="geometry"/></mxCell><mxCell id="m6" value="M6 Polaris federation PoC&lt;br&gt;No 32 ~ 34&lt;br&gt;(모드 ① 일 때만)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FEB;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="240" height="120" as="geometry"/></mxCell><mxCell id="m7" value="M7 운영 이관&lt;br&gt;No 35&lt;br&gt;복제·ILM 정책 적용 · 가이드" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="270" width="240" height="120" as="geometry"/></mxCell><mxCell id="g40" value="G0 Warm 을 HMS 로 조회하는&lt;br&gt;케이스가 있는가? (모드 결정)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#DD344C;fontSize=12;fontColor=#DD344C;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="240" height="60" as="geometry"/></mxCell><mxCell id="g320" value="G1 복제 목적 · 버킷명 동일 여부" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#DD344C;fontSize=12;fontColor=#DD344C;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="240" height="60" as="geometry"/></mxCell><mxCell id="g320" value="G2 아카이브 방식&lt;br&gt;A / B / C 협의" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#DD344C;fontSize=12;fontColor=#DD344C;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="240" height="60" as="geometry"/></mxCell><mxCell id="lg" value="G0 = 예 → 모드 ① 실시간 복제 + M4·M5·M6 진행   |   G0 = 아니오 → 모드 ② 백업(M2 의 백업 시점 테스트 결과로 주기 결정) 또는 모드 ③ 복제 불필요 → M4·M5·M6 보류&lt;br&gt;M3(ILM/Archive) 는 Replication 결정(M2) 이후 착수 · Rollover Job 은 협의 결과(G2)가 C 일 때만 구현" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#5E6C84;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1470" height="80" as="geometry"/></mxCell><mxCell id="c11" value="해야 할 일 — 마일스톤 의존 관계 (Replication 우선 → ILM → 향후 구성)" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#000000;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1480" height="30" as="geometry"/></mxCell><mxCell id="c12" value="박스 안 No = INDEX §3 작업 번호 · 빨간 게이트 = 다음 단계 착수 전 확정해야 할 결정 · 점선 박스 = 게이트 결과에 따라 조건부" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5E6C84;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1480" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
