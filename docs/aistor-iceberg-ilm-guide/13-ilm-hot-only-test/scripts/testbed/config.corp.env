# corp 클러스터 ns ilm-test 테스트베드용 설정 (자격증명 없음 — Secret 은 testbed/setup.sh 가 만든다)
# 사용: source testbed/config.corp.env   (scripts/ 디렉터리에서)
export HOT_ALIAS=HOT
export WARM_ALIAS=WARM
export HOT_ENDPOINT=http://minio-hot.ilm-test.svc:9000
export BUCKET=warehouse
export TIER_NAME=WARM-TIER
export WARM_TIER_BUCKET=warm-tier
export TIER_ACCESS_KEY=tier-svc

# 스모크: TRANSITION_DAYS=0 SCANNER_GRACE_HOURS=0 DB=ilmsmoke 로 덮어써서 실행
export TRANSITION_DAYS=${TRANSITION_DAYS:-1}
export SCANNER_GRACE_HOURS=${SCANNER_GRACE_HOURS:-24}
export NONCURRENT_EXPIRE_DAYS=3
export VERSIONING=on

export HMS_URI=thrift://hive-metastore.ilm-test.svc:9083
export CATALOG=hive_prod
export DB=${DB:-ilmtest}
export TABLE=events
export LEDGER_TABLE=ledger
export TABLE_PREFIX="${DB}.db/${TABLE}"
export ROWS_PER_BATCH=200000

export K8S_NS=ilm-test
# 실행(run)마다 하위 디렉터리 — 공유 디렉터리는 sticky(1777)라 다른 UID 파일을 옮길 수 없다
export RUN_ID=${RUN_ID:-run}
export EVIDENCE_DIR=/shared/evidence/${RUN_ID}
export SPARK_JARS=/shared/jars/iceberg-spark-runtime-3.5_2.12-1.9.0.jar,/shared/jars/iceberg-aws-bundle-1.9.0.jar
export HOT_METRICS_URLS=http://minio-hot.ilm-test.svc:9000/minio/v2/metrics/cluster,http://minio-hot.ilm-test.svc:9000/minio/v2/metrics/node
export FLUENT_BIT_CONF=fluent-bit/audit-receiver-file.yaml
