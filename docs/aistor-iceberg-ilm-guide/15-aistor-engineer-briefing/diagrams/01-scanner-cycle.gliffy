    "graphic": {
     "type": "Shape",
     "Shape": {
      "tid": "com.gliffy.stencil.round_rectangle.basic_v1",
      "strokeWidth": 1.5,
      "strokeColor": "#232F3E",
      "fillColor": "#F4F6F8",
      "gradient": false,
      "dashStyle": null,
      "dropShadow": false,
