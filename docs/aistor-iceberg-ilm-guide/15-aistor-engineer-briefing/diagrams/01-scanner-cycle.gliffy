    "children": [
     {
      "x": 0,
      "y": 0,
      "rotation": 0,
      "id": 61,
      "uid": null,
      "width": 1420,
      "height": 100,
      "lockAspectRatio": false,
      "lockShape": false,
      "order": 0,
      "graphic": {
       "type": "Text",
       "Text": {
        "tid": null,
        "valign": "middle",
        "overflow": "none",
        "vposition": "none",
        "hposition": "none",
        "html": "<p style=\"text-align:left;\"><span style=\"font-size:13px;line-height:16px;color:#232F3E;\">speed 를 올리면 ①~⑤ 가 모두 빨라진다 → ILM 만 빠르게 할 수 없다 (질의 Q-S1) · fastest 는 할 일이 없어도 Hot CPU 14m → 82m (실측)<br>규칙의 만기가 지나도 Scanner 가 그 폴더에 오기 전까지는 아무 일도 없다 → ILM 반응 시간 = Days + 00:00 올림 + 사이클 길이</span></p>",
        "paddingLeft": 4,
        "paddingRight": 4,
        "paddingBottom": 3,
        "paddingTop": 3
       }
      },
      "linkMap": []
     }
    ],
    "linkMap": [],
    "hidden": false
   },
   {
    "x": 40,
    "y": 16,
    "rotation": 0,
    "id": 63,
    "uid": "com.gliffy.shape.basic.basic_v1.default.text",
    "width": 1420,
    "height": 30,
    "lockAspectRatio": false,
    "lockShape": false,
    "order": 38,
    "graphic": {
     "type": "Text",
     "Text": {
      "tid": null,
      "valign": "middle",
      "overflow": "none",
      "vposition": "none",
      "hposition": "none",
      "html": "<p style=\"text-align:left;\"><span style=\"font-size:22px;line-height:25px;color:#000000;font-weight:bold;\">Scanner — 모든 버킷 · 폴더 · 객체 · 버전을 쉬지 않고 한 바퀴씩</span></p>",
      "paddingLeft": 4,
      "paddingRight": 4,
      "paddingBottom": 3,
      "paddingTop": 3
     }
    },
    "children": [],
    "linkMap": [],
    "hidden": false
   },
   {
    "x": 40,
    "y": 48,
    "rotation": 0,
    "id": 64,
    "uid": "com.gliffy.shape.basic.basic_v1.default.text",
    "width": 1420,
    "height": 20,
    "lockAspectRatio": false,
    "lockShape": false,
    "order": 39,
    "graphic": {
     "type": "Text",
     "Text": {
      "tid": null,
      "valign": "middle",
      "overflow": "none",
      "vposition": "none",
      "hposition": "none",
      "html": "<p style=\"text-align:left;\"><span style=\"font-size:12px;line-height:15px;color:#5E6C84;\">ILM 규칙은 판단 기준일 뿐 · 실행은 Scanner 가 그 객체를 방문할 때 · 한 번의 방문에서 ILM 외 일도 같이 한다</span></p>",
      "paddingLeft": 4,
      "paddingRight": 4,
      "paddingBottom": 3,
      "paddingTop": 3
     }
    },
    "children": [],
    "linkMap": [],
    "hidden": false
