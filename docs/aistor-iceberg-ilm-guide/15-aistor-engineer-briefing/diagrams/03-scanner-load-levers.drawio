<mxGeometry x="65" y="305" width="400" height="70" as="geometry"/></mxCell><mxCell id="a1" value="버전 수 — Noncurrent 1d · NewerNoncurrent 질의&lt;br&gt;Iceberg 삭제 = 비현행 + DM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7E6;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="390" width="400" height="70" as="geometry"/></mxCell><mxCell id="a2" value="delete marker — ExpiredObjectDeleteMarker" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7E6;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="475" width="400" height="70" as="geometry"/></mxCell><mxCell id="a3" value="폴더 — 파티션 너무 잘게 X · 폴더당 객체 경보" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7E6;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="560" width="400" height="70" as="geometry"/></mxCell><mxCell id="b0" value="태그 기반 즉시 전이 (03 문서)&lt;br&gt;compaction 이 태그 붙여 쓰면 PUT 순간 Warm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="305" width="400" height="70" as="geometry"/></mxCell><mxCell id="b1" value="Soft delete 태그 (04 문서)&lt;br&gt;ILM 은 Iceberg 가 지운 파일만 만료" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="390" width="400" height="70" as="geometry"/></mxCell><mxCell id="b2" value="Batch 전이 작업 질의 Q-I7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="475" width="400" height="70" as="geometry"/></mxCell><mxCell id="b3" value="효과: 전이가 사이클과 무관 → Scanner 를 낮춰도 됨" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="560" width="400" height="70" as="geometry"/></mxCell><mxCell id="c0" value="업무 시간 slow · 야간 default/fast&lt;br&gt;CronJob 으로 speed 변경" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1035" y="305" width="400" height="70" as="geometry"/></mxCell><mxCell id="c1" value="전제: 즉시 반영 질의 Q-S4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1035" y="390" width="400" height="70" as="geometry"/></mxCell><mxCell id="c2" value="자정(KST 09:00) 쏠림 — B 로 제거가 확실" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1035" y="475" width="400" height="70" as="geometry"/></mxCell><mxCell id="c3" value="주의: 반응 시간은 오히려 늘 수 있다" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1035" y="560" width="400" height="70" as="geometry"/></mxCell><mxCell id="n" value="실측: fastest 유휴 Hot CPU 14m → 82m · 기본 4.5 객체/s (단일 노드) · 전이 후 읽기 지연은 파일 수에 비례 (파티션 +26% · 전체 스캔 +40%)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;fontSize=13;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1420" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Scanner 부하 모델 — 무엇이 비용을 만들고, 어떤 손잡이로 줄이나" style="tex