     "Text": {
      "tid": null,
      "valign": "middle",
      "overflow": "none",
      "vposition": "none",
      "hposition": "none",
      "html": "<p style=\"text-align:left;\"><span style=\"font-size:22px;line-height:25px;color:#000000;font-weight:bold;\">Replication + ILM — 같은 버킷에 그대로 쓰기 어려운 이유</span></p>",
