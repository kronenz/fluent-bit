0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="453" y="272" width="34" height="34" as="geometry"/></mxCell><mxCell id="f2" value="db.db/tbl/data/p=10-26/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="110" y="329" width="260" height="44" as="geometry"/></mxCell><mxCell id="o2" value="" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.5;fontColor=#7D8998;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="453" y="334" width="34" height="34" as="geometry"/></mxCell><mxCell id="f3" value="db.db/tbl/metadata/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="110" y="391" width="260" height="44" as="geometry"/></mxCell><mxCell id="o3" value="" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.5;fontColor=#7D8998;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="453" y="396" width="34" height="34" as="geometry"/></mxCell><mxCell id="b2" value="버킷 raw · 기타 …" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C72C48;fontSize=12;fontColor=#232F3E;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="240" height="40" as="geometry"/></mxCell><mxCell id="loop" value="폴더 하나씩 처리 → 다음 폴더 (사이 사이 '쉬는 시간' = speed)&lt;br&gt;모든 버킷을 다 돌면 1 사이클 → 잠시 쉬고 다음 사이클&lt;br&gt;실측 4,000 객체: 100개(폴더 1개)씩 계단 · 기본 914초 / fastest 25초" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="540" width="500" height="96" as="geometry"/></mxCell><mxCell id="j0" value="① 사용량 집계&lt;br&gt;버킷 · prefix 크기 · 객체 수 · 버전 수" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="145" width="380" height="80" as="geometry"/></mxCell><mxCell id="j1" value="② ILM 평가&lt;br&gt;Transition · Expiration · Noncurrent · DM 정리&lt;br&gt;만기면 작업 큐로" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=1;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="245" width="380" height="80" as="geometry"/></mxCell><mxCell id="j2" value="③ Healing 점검&lt;br&gt;일정 확률로 조각 무결성 확인 · 복구" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="345" width="380" height="80" as="geometry"/></mxCell><mxCell id="j3" value="④ 복제 점검&lt;br&gt;실패 · 대기 객체 재큐잉 (Replication 사용 시)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="445" width="380" height="80" as="geometry"/></mxCell><mxCell id="j4" value="⑤ 경보&lt;br&gt;버전 과다(100) · 폴더 과다(50,000)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="545" width="380" height="80" as="geometry"/></mxCell><mxCell id="tq" value="전이 작업 큐&lt;br&gt;→ tier 계정으로 Warm 에 PUT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1165" y="160" width="270" height="70" as="geometry"/></mxCell><mxCell id="eq" value="만료 작업&lt;br&gt;→ delete marker / 삭제 · tier journal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1165" y="250" width="270" height="70" as="geometry"/></mxCell><mxCell id="put" value="PUT 순간 이미 만기?&lt;br&gt;(0d 규칙 · 태그 + 0d · 소급)&lt;br&gt;→ Scanner 없이 즉시 큐로" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7E6;strokeColor=#7AA116;fontSize=12;fontColor=#232F3E;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1165" y="420" width="270" height="110" as="geometry"/></mxCell><mxCell id="miss" value="큐가 넘치면&lt;br&gt;missed_immediate_tasks ↑ (질의 Q-I1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#DD344C;fontSize=12;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1165" y="560" width="270" height="70" as="geometry"/></mxCell><mxCell id="note" value="speed 를 올리면 ①~⑤ 가 모두 빨라진다 → ILM 만 빠르게 할 수 없다 (질의 Q-S1) · fastest 는 할 일이 없어도 Hot CPU 14m → 82m (실측)&lt;br&gt;규칙의 만기가 지나도 Scanner 가 그 폴더에 오기 전까지는 아무 일도 없다 → ILM 반응 시간 = Days + 00:00 올림 + 사이클 길이" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;fontSize=13;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1420" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Scanner — 모든 버킷 · 폴더 · 객체 · 버전을 쉬지 않고 한 바퀴씩" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#000000;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1420" height="30" as="geometry"/></mxCell><mxCell id="c12" value="ILM 규칙은 판단 기준일 뿐 · 실행은 Scanner 가 그 객체를 방문할 때 · 한 번의 방문에서 ILM 외 일도 같이 한다" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5E6C84;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1420" height="20" as="geometry"/></mxCell><mxCell id="c13" va