><mxGeometry x="400" y="160" width="300" height="160" as="geometry"/></mxCell><mxCell id="n2" value="S3&lt;br&gt;&lt;br&gt;delete marker&lt;br&gt;+ Warm 원본 삭제" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C72C48;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="160" width="300" height="160" as="geometry"/></mxCell><mxCell id="n3" value="조회&lt;br&gt;&lt;br&gt;age6 · 전체 스캔 · time travel&lt;br&gt;✗ NotFoundException" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#DD344C;fontSize=13;fontColor=#DD344C;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="300" height="160" as="geometry"/></mxCell><mxCell id="o0" value="Iceberg 보존 작업&lt;br&gt;&lt;br&gt;DELETE · expire_snapshots&lt;br&gt;카탈로그: s3.delete-enabled=false" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="300" height="160" as="geometry"/></mxCell><mxCell id="o1" value="S3 (지우지 않음)&lt;br&gt;&lt;br&gt;태그만&lt;br&gt;iceberg-deleted=true" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C72C48;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="300" height="160" as="geometry"/></mxCell><mxCell id="o2" value="ILM (태그만 봄)&lt;br&gt;&lt;br&gt;Expiration 1d&lt;br&gt;And{data/, iceberg-deleted}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=13;fontColor=#232F3E;fontStyle=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="470" width="300" height="160" as="geometry"/></mxCell><mxCell id="o3" value="결과&lt;br&gt;&lt;br&gt;태그 4개만 delete marker&lt;br&gt;같은 나이 살아 있는 4개 그대로&lt;br&gt;테이블 정상 ✓" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7E6;strokeColor=#7AA116;fontSize=13;fontColor=#232F3E;fontStyle=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="300" height="160" as="geometry"/></mxCell><mxCell id="tail" value="이어서 (Versioning ON): 비현행 1d → 00:00 올림 → Warm 공간 회수 · 고아 delete marker 정리 (실측 E-5 10-28 00:00 UTC)&lt;br&gt;Expiration Days 는 객체 생성 시점부터 센다 → 보존 작업이 지운 오래된 파일은 다음 Scanner 방문에 바로 처리" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="1420" height="66" as="geometry"/></mxCell><mxCell id="c11" value="Iceberg × ILM 만료 — 나이 기반은 테이블을 깨고, soft delete 태그는 안전하다" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#000000;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1420" height="30" as="geometry"/></mxCell><mxCell id="c12" value="Iceberg 의 살아 있는 파일 = 남은 스냅샷이 참조하는 파일 · S3 수명주기는 객체 나이만 본다" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#5E6C84;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1420" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
