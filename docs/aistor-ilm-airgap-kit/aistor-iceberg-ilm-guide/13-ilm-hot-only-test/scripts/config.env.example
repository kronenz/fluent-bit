# 13-ilm-hot-only-test 공통 설정 — config.env 로 복사해 사용 (config.env 는 커밋 금지)
# 자격증명은 여기 두지 않는다: mc alias(HOT/WARM) 와 k8s Secret(ilmtest-s3) 에만 둔다.

# ── S3 ─────────────────────────────────────────────
export HOT_ALIAS=HOT                         # mc alias (Hot)
export WARM_ALIAS=WARM                       # mc alias (Warm) — 규칙 검사·audit 설정용
export HOT_ENDPOINT=https://hot-s3.example.internal
export BUCKET=warehouse                      # Hot Iceberg 버킷
export TIER_NAME=WARM-TIER                   # Hot 에 등록된 remote tier 이름
export WARM_TIER_BUCKET=warm-tier            # Warm 쪽 tier 대상 버킷
export TIER_ACCESS_KEY=tier-svc              # Hot 이 Warm 에 접근할 때 쓰는 계정 (J-7 판정 기준)

# ── ILM ────────────────────────────────────────────
export TRANSITION_DAYS=${TRANSITION_DAYS:-1}  # 사전 확인 시 0
export SCANNER_GRACE_HOURS=${SCANNER_GRACE_HOURS:-24}
export NONCURRENT_EXPIRE_DAYS=3              # Versioning ON 일 때만 적용 (최소 1)
export VERSIONING=on                         # on | off

# ── Iceberg ────────────────────────────────────────
export HMS_URI=thrift://hms.data.svc.cluster.local:9083
export CATALOG=hive_prod
export DB=${DB:-ilmtest}                     # 시험별로 덮어쓴다 (ilmperf · ilmexp …)
export TABLE=events
export LEDGER_TABLE=ledger
export TABLE_PREFIX="${DB}.db/${TABLE}"      # S3 상 테이블 경로 (HMS location 으로 확인 🔍)
export ROWS_PER_BATCH=200000

# ── K8s / 수집 ─────────────────────────────────────
export K8S_NS=ilm-test
export RUN_ID=${RUN_ID:-run}
export EVIDENCE_DIR=/shared/evidence/${RUN_ID}    # 공유 볼륨(RWX) — 실행마다 하위 디렉터리
export SPARK_JARS=/shared/jars/iceberg-spark-runtime-3.5_2.12-1.9.0.jar,/shared/jars/iceberg-aws-bundle-1.9.0.jar
export HOT_METRICS_URLS=${HOT_ENDPOINT}/minio/v2/metrics/cluster,${HOT_ENDPOINT}/minio/v2/metrics/node   # 🔍 AIStor 는 metrics 인증 토큰 필요할 수 있음
export FLUENT_BIT_CONF=fluent-bit/audit-receiver-file.yaml
# ── 폐쇄망 ─────────────────────────────────────────
# export IMAGE_REGISTRY=registry.local/mirror    # 매니페스트 image: 를 사내 레지스트리로 (lib.sh)
# export MAVEN_REPO=https://nexus.local/repository/maven-public
export AUDIT_ENDPOINT=http://fluent-bit-audit.ilm-test.svc:8888   # Fluent Bit http input
export AUDIT_TOKEN=change-me
