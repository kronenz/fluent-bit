<mxfile host="app.diagrams.net" type="device" version="24.0.0"><diagram name="02-data-lifecycle" id="02-data-lifecycle"><mxGraphModel dx="1500" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ok" value="권장 — 삭제는 Iceberg 가, Warm 공간 회수는 ILM 비현행 만료가" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=34;spacingTop=4;fontSize=13;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1420" height="230" as="geometry"/></mxCell><mxCell id="ok_b" value="✓" style="rounded=0;html=1;fillColor=#7AA116;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="26" height="26" as="geometry"/></mxCell><mxCell id="ng" value="금지 — ILM current Expiration 을 data/ 에 건다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=34;spacingTop=4;fontSize=13;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1420" height="230" as="geometry"/></mxCell><mxCell id="ng_b" value="✗" style="rounded=0;html=1;fillColor=#DD344C;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="26" height="26" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#232F3E;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="140" as="sourcePoint"/><mxPoint x="1440" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#7AA116;strokeWidth=2;edgeStyle=none;" edge="1" parent="1